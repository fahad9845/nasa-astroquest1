# Local SQLite fallback; use npm run db:setup.
DATABASE_URL="file:./astroquest.db"
PORT=3001
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Production: PostgreSQL connection with sslmode=require, then npm run db:postgres.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Vite build only: leave empty for same-origin hosting or the Vite development proxy.
VITE_API_URL=
# Set true only for a static guest-only build without the account API.
VITE_GUEST_ONLY=false
# Cross-site Vercel/Render cookies require SameSite=None and HTTPS.
COOKIE_SAME_SITE=lax
